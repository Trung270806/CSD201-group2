FlashSaleItemRepository.java

Java
package repository;

import model.FlashSaleItem;
import exception.OutOfStockException;
import exception.OptimisticLockException;

import java.io.*;
import java.nio.channels.FileChannel;
import java.nio.channels.FileLock;
import java.nio.file.*;
import java.util.*;
import java.util.concurrent.locks.ReentrantLock;
import java.util.stream.Collectors;

public class FlashSaleItemRepository {
    private final String filePath = "data/flash_items.csv";
    private final ReentrantLock memoryLock = new ReentrantLock();

    public FlashSaleItemRepository() {
        try {
            Files.createDirectories(Paths.get("data"));
            if (!Files.exists(Paths.get(filePath))) {
                List<String> header = Arrays.asList("id,productId,limitedQty,soldQty,version");
                Files.write(Paths.get(filePath), header);
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    public List<FlashSaleItem> findAll() throws IOException {
        try (BufferedReader br = Files.newBufferedReader(Paths.get(filePath))) {
            return br.lines()
                     .skip(1)
                     .filter(line -> !line.trim().isEmpty())
                     .map(line -> {
                         FlashSaleItem item = new FlashSaleItem();
                         item.fromCsvLine(line);
                         return item;
                     })
                     .collect(Collectors.toList());
        }
    }

    private void saveAll(List<FlashSaleItem> items) throws IOException {
        try (BufferedWriter bw = Files.newBufferedWriter(Paths.get(filePath))) {
            bw.write("id,productId,limitedQty,soldQty,version");
            bw.newLine();
            for (FlashSaleItem item : items) {
                bw.write(item.toCsvLine());
                bw.newLine();
            }
        }
    }

    public void sellWithNoLock(int itemId, int qty) throws IOException, OutOfStockException {
        List<FlashSaleItem> items = findAll();
        FlashSaleItem target = items.stream().filter(i -> i.getId() == itemId).findFirst().orElse(null);

        if (target == null) return;

        if (target.getSoldQty() + qty > target.getLimitedQty()) {
            throw new OutOfStockException("Hết hàng (No Lock)!");
        }

        try { Thread.sleep(5); } catch (InterruptedException ignored) {}

        target.setSoldQty(target.getSoldQty() + qty);
        saveAll(items);
    }

    public void sellWithSynchronized(int itemId, int qty) throws IOException, OutOfStockException {
        memoryLock.lock();
        try {
            List<FlashSaleItem> items = findAll();
            FlashSaleItem target = items.stream().filter(i -> i.getId() == itemId).findFirst().orElse(null);

            if (target == null) return;
            if (target.getSoldQty() + qty > target.getLimitedQty()) {
                throw new OutOfStockException("Hết hàng!");
            }

            target.setSoldQty(target.getSoldQty() + qty);
            saveAll(items);
        } finally {
            memoryLock.unlock();
        }
    }

    public void sellWithFileLock(int itemId, int qty) throws IOException, OutOfStockException {
        File file = new File(filePath);
        try (RandomAccessFile raf = new RandomAccessFile(file, "rw");
             FileChannel channel = raf.getChannel()) {

            try (FileLock lock = channel.lock()) { 
                List<FlashSaleItem> items = new ArrayList<>();
                raf.seek(0);
                String line = raf.readLine(); 
                while ((line = raf.readLine()) != null) {
                    if(!line.trim().isEmpty()){
                        FlashSaleItem item = new FlashSaleItem();
                        item.fromCsvLine(line);
                        items.add(item);
                    }
                }

                FlashSaleItem target = items.stream().filter(i -> i.getId() == itemId).findFirst().orElse(null);
                if (target == null) return;

                if (target.getSoldQty() + qty > target.getLimitedQty()) {
                    throw new OutOfStockException("Hết hàng!");
                }

                target.setSoldQty(target.getSoldQty() + qty);

                raf.setLength(0); 
                raf.writeBytes("id,productId,limitedQty,soldQty,version\n");
                for (FlashSaleItem item : items) {
                    raf.writeBytes(item.toCsvLine() + "\n");
                }
            }
        }
    }

    public void sellWithOptimisticLock(int itemId, int qty) throws IOException, OutOfStockException, OptimisticLockException {
        List<FlashSaleItem> items = findAll();
        FlashSaleItem target = items.stream().filter(i -> i.getId() == itemId).findFirst().orElse(null);

        if (target == null) return;
        if (target.getSoldQty() + qty > target.getLimitedQty()) {
            throw new OutOfStockException("Hết hàng!");
        }

        int currentVersion = target.getVersion(); 

        target.setSoldQty(target.getSoldQty() + qty);
        target.setVersion(currentVersion + 1); 

        synchronized (this) {
            List<FlashSaleItem> latestItems = findAll();
            FlashSaleItem dbTarget = latestItems.stream().filter(i -> i.getId() == itemId).findFirst().orElse(null);

            if (dbTarget != null && dbTarget.getVersion() != currentVersion) {
                throw new OptimisticLockException("Xung đột dữ liệu!");
            }

            saveAll(latestItems.stream().map(i -> i.getId() == itemId ? target : i).collect(Collectors.toList()));
        }
    }
}
