3. TẦNG REPOSITORY (Nơi xử lý file CSV và Đa luồng)   
DOCX
+ 1

Đây chính là "trái tim" của dự án, giải quyết Big Question về Race Condition trên file CSV. Mình viết bằng cơ chế I/O thuần của Java 8 giúp đọc ghi file cực nhanh.  
DOCX
+ 1

FlashSaleItemRepository.java
Java
package repository;

import model.FlashSaleItem;
import exception.OutOfStockException;
import exception.OptimisticLockException;

import java.io.*;
import java.nio.channels.FileChannel;
import java.nio.channels.FileLock;
import java.nio.file.*;
import java.util.*;
import java.util.concurrent.locks.ReentrantLock;
import java.util.stream.Collectors;

public class FlashSaleItemRepository {
    private final String filePath = "data/flash_items.csv";
    private final ReentrantLock memoryLock = new ReentrantLock();

    public FlashSaleItemRepository() {
        // Đảm bảo thư mục data và file tồn tại
        try {
            Files.createDirectories(Paths.get("data"));
            if (!Files.exists(Paths.get(filePath))) {
                List<String> header = Arrays.asList("id,productId,limitedQty,soldQty,version");
                Files.write(Paths.get(filePath), header);
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    // Đọc tất cả các item từ file CSV (Dùng Stream API của Java 8)
    public List<FlashSaleItem> findAll() throws IOException {
        try (BufferedReader br = Files.newBufferedReader(Paths.get(filePath))) {
            return br.lines()
                     .skip(1) // Bỏ qua dòng header
                     .filter(line -> !line.trim().isEmpty())
                     .map(line -> {
                         FlashSaleItem item = new FlashSaleItem();
                         item.fromCsvLine(line);
                         return item;
                     })
                     .collect(Collectors.toList());
        }
    }

    // Ghi đè lại toàn bộ danh sách vào file CSV
    private void saveAll(List<FlashSaleItem> items) throws IOException {
        try (BufferedWriter bw = Files.newBufferedWriter(Paths.get(filePath))) {
            bw.write("id,productId,limitedQty,soldQty,version");
            bw.newLine();
            for (FlashSaleItem item : items) {
                bw.write(item.toCsvLine());
                bw.newLine();
            }
        }
    }

    // =================================================================
    // 1. CO CHẾ: NO LOCK (Gây ra tình trạng âm kho để làm Baseline) 
    // =================================================================
    public void sellWithNoLock(int itemId, int qty) throws IOException, OutOfStockException {
        List<FlashSaleItem> items = findAll();
        FlashSaleItem target = items.stream().filter(i -> i.getId() == itemId).findFirst().orElse(null);

        if (target == null) return;

        // Trích xuất bước: Đọc -> Kiểm tra -> Trừ kho (Gây Race Condition tại đây) [cite: 9]
        if (target.getSoldQty() + qty > target.getLimitedQty()) {
            throw new OutOfStockException("Hết hàng (No Lock)!");
        }

        // Giả lập một chút delay nhỏ để "kích hoạt" cửa sổ nguy hiểm (Race Window) [cite: 10]
        try { Thread.sleep(5); } catch (InterruptedException ignored) {}

        target.setSoldQty(target.getSoldQty() + qty);
        saveAll(items);
    }

    // =================================================================
    // 2. CƠ CHẾ: SYNCHRONIZED (Khóa mức ứng dụng - Memory Lock) 
    // =================================================================
    public void sellWithSynchronized(int itemId, int qty) throws IOException, OutOfStockException {
        memoryLock.lock(); // Chặn tất cả các luồng khác ở mức JVM
        try {
            List<FlashSaleItem> items = findAll();
            FlashSaleItem target = items.stream().filter(i -> i.getId() == itemId).findFirst().orElse(null);

            if (target == null) return;
            if (target.getSoldQty() + qty > target.getLimitedQty()) {
                throw new OutOfStockException("Hết hàng!");
            }

            target.setSoldQty(target.getSoldQty() + qty);
            saveAll(items);
        } {
            memoryLock.unlock();
        }
    }

    // =================================================================
    // 3. CƠ CHẾ: FILE LOCK (Khóa độc quyền ở mức Hệ điều hành vật lý) 
    // =================================================================
    public void sellWithFileLock(int itemId, int qty) throws IOException, OutOfStockException {
        // Dùng RandomAccessFile và FileChannel của Java NIO để khóa file vật lý 
        File file = new File(filePath);
        try (RandomAccessFile raf = new RandomAccessFile(file, "rw");
             FileChannel channel = raf.getChannel()) {
            
            // Luồng sẽ đợi ở đây cho đến khi lấy được khóa độc quyền độc chiếm file CSV
            try (FileLock lock = channel.lock()) { 
                // Đọc dữ liệu hiện tại từ file
                List<FlashSaleItem> items = new ArrayList<>();
                raf.seek(0);
                String line = raf.readLine(); // Bỏ qua header
                while ((line = raf.readLine()) != null) {
                    if(!line.trim().isEmpty()){
                        FlashSaleItem item = new FlashSaleItem();
                        item.fromCsvLine(line);
                        items.add(item);
                    }
                }

                FlashSaleItem target = items.stream().filter(i -> i.getId() == itemId).findFirst().orElse(null);
                if (target == null) return;

                if (target.getSoldQty() + qty > target.getLimitedQty()) {
                    throw new OutOfStockException("Hết hàng!");
                }

                target.setSoldQty(target.getSoldQty() + qty);

                // Ghi đè ngược lại dữ liệu mới vào file
                raf.setLength(0); // Xóa dữ liệu cũ
                raf.writeBytes("id,productId,limitedQty,soldQty,version\n");
                for (FlashSaleItem item : items) {
                    raf.writeBytes(item.toCsvLine() + "\n");
                }
            }
        }
    }

    // =================================================================
    // 4. CƠ CHẾ: OPTIMISTIC LOCKING (Khóa lạc quan bằng biến Version) [cite: 27, 45]
    // =================================================================
    public void sellWithOptimisticLock(int itemId, int qty) throws IOException, OutOfStockException, OptimisticLockException {
        // Không dùng từ khóa chặn luồng, đọc file tự do
        List<FlashSaleItem> items = findAll();
        FlashSaleItem target = items.stream().filter(i -> i.getId() == itemId).findFirst().orElse(null);

        if (target == null) return;
        if (target.getSoldQty() + qty > target.getLimitedQty()) {
            throw new OutOfStockException("Hết hàng!");
        }

        int currentVersion = target.getVersion(); // Lấy version hiện tại ra lưu lại 
        
        // Cập nhật dữ liệu tạm thời trong bộ nhớ
        target.setSoldQty(target.getSoldQty() + qty);
        target.setVersion(currentVersion + 1); // Tăng version lên 

        // Khóa đồng bộ rất ngắn chỉ để kiểm tra và ghi đè xuống file CSV
        synchronized (this) {
            List<FlashSaleItem> latestItems = findAll();
            FlashSaleItem dbTarget = latestItems.stream().filter(i -> i.getId() == itemId).findFirst().orElse(null);

            // Nếu số version trong file đã bị luồng khác thay đổi mất rồi -> Thất bại ngay lập tức 
            if (dbTarget != null && dbTarget.getVersion() != currentVersion) {
                throw new OptimisticLockException("Xung đột dữ liệu! Một luồng khác đã mua trước.");
            }

            // Nếu trùng khớp version, ghi đè danh sách mới nhất xuống file CSV
            saveAll(latestItems.stream().map(i -> i.getId() == itemId ? target : i).collect(Collectors.toList()));
        }
    }
}
4. TẦNG CONTROLLER & SIMULATOR (Dùng CountDownLatch điều khiển luồng)   
DOCX
+ 2

Đây là công cụ kiểm thử mô phỏng hàng trăm khách hàng nhấn nút mua cùng lúc bằng CountDownLatch để chứng minh giải thuật hoạt động đúng yêu cầu.  
DOCX
+ 1

SimulatorController.java
Java
package controller;

import model.LockMechanism;
import repository.FlashSaleItemRepository;

import java.util.concurrent.CountDownLatch;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;

public class SimulatorController {
    private final FlashSaleItemRepository repo = new FlashSaleItemRepository();

    public void runSimulation(int threadCount, LockMechanism mechanism) {
        ExecutorService executor = Executors.newFixedThreadPool(threadCount);
        CountDownLatch startLatch = new CountDownLatch(1); // Giúp các luồng xuất phát cùng 1 tích tắc [cite: 49]
        CountDownLatch endLatch = new CountDownLatch(threadCount);

        AtomicInteger successCount = new AtomicInteger(0);
        AtomicInteger failedCount = new AtomicInteger(0);

        System.out.println(">>> Bắt đầu mô phỏng với cơ chế: " + mechanism + " với " + threadCount + " luồng...");
        long startTime = System.currentTimeMillis();

        for (int i = 0; i < threadCount; i++) {
            executor.submit(() -> {
                try {
                    startLatch.await(); // Chờ lệnh còi xuất phát [cite: 49]
                    
                    // Thử mua 1 sản phẩm có ID = 1
                    switch (mechanism) {
                        case NO_LOCK:
                            repo.sellWithNoLock(1, 1);
                            break;
                        case SYNCHRONIZED:
                            repo.sellWithSynchronized(1, 1);
                            break;
                        case FILE_LOCK:
                            repo.sellWithFileLock(1, 1);
                            break;
                        case OPTIMISTIC:
                            // Với Optimistic ta có thể bọc vòng lặp retry tối đa 3 lần nếu muốn 
                            repo.sellWithOptimisticLock(1, 1);
                            break;
                    }
                    successCount.incrementAndGet();
                } catch (Exception e) {
                    failedCount.incrementAndGet();
                } finally {
                    endLatch.countDown();
                }
            });
        }

        startLatch.countDown(); // Phát lệnh: BẮT ĐẦU ĐUA! [cite: 49]
        try {
            endLatch.await(30, TimeUnit.SECONDS); // Chờ cuộc đua kết thúc
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        long endTime = System.currentTimeMillis();
        long duration = endTime - startTime;
        double tps = (double) successCount.get() / (duration / 1000.0); // Tính toán throughput 

        System.out.println("------ KẾT QUẢ MÔ PHỎNG ------");
        System.out.println("Thời gian thực hiện: " + duration + " ms");
        System.out.println("Đơn thành công: " + successCount.get());
        System.out.println("Đơn thất bại (Do chặn/Hết hàng): " + failedCount.get());
        System.out.println("Tốc độ xử lý (Throughput): " + String.format("%.2f", tps) + " đơn/giây");
        System.out.println("-----------------------------\n");

        executor.shutdown();
    }
}
5. HÀM MAIN CHẠY THỬ NGHIỆM (View/App Entry)
Tạo dữ liệu ảo ban đầu để chạy test thử nghiệm.  
DOCX

MainApp.java
Java
import controller.SimulatorController;
import model.FlashSaleItem;
import model.LockMechanism;

import java.io.BufferedWriter;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.Arrays;
import java.util.List;

public class MainApp {
    public static void main(String[] args) throws Exception {
        // Khởi tạo dữ liệu mẫu cho file flash_items.csv trước khi test
        // Sản phẩm ID = 1, Kho giới hạn = 10, Đã bán = 0, Version = 1
        Files.createDirectories(Paths.get("data"));
        try (BufferedWriter bw = Files.newBufferedWriter(Paths.get("data/flash_items.csv"))) {
            bw.write("id,productId,limitedQty,soldQty,version\n");
            bw.write("1,101,10,0,1\n"); 
        }

        SimulatorController simulator = new SimulatorController();

        // TEST 1: Thử chạy NO_LOCK với 50 luồng tranh nhau mua 10 sản phẩm
        // Bồ sẽ thấy số lượng bán thành công vượt quá 10 đơn (Gây âm kho thực tế)! [cite: 8, 49]
        simulator.runSimulation(50, LockMechanism.NO_LOCK);

        // Reset lại kho về 0 để test cơ chế an toàn
        try (BufferedWriter bw = Files.newBufferedWriter(Paths.get("data/flash_items.csv"))) {
            bw.write("id,productId,limitedQty,soldQty,version\n");
            bw.write("1,101,10,0,1\n"); 
        }

        // TEST 2: Thử chạy SYNCHRONIZED hoặc OPTIMISTIC
        // Đảm bảo số đơn thành công LUÔN LUÔN CHÍNH XÁC LÀ 10, không bao giờ vượt quá kho [cite: 45, 49]
        simulator.runSimulation(50, LockMechanism.SYNCHRONIZED);
    }
}
Kế hoạch tiếp theo của tụi mình:
Bộ mã nguồn lõi xử lý concurrency trên đã sẵn sàng rồi đó bồ! Để hoàn thiện 100% đồ án đạt điểm tối đa, tụi mình cần mở rộng thêm:

Viết file DataGenerator.java để tự động sinh ngẫu nhiên ≥ 10,000 dòng cho đủ 6 file CSV theo yêu cầu Tuần 1-2.  
