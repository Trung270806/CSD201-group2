public Transaction deleteTransaction(int id) {

    if(head == null) {
        System.out.println("Empty List");
        return null;
    }

    TransactionNode current = head;

    while(current != null) {

        if(current.data.id == id) {

            Transaction deletedData =
                current.data;

            // delete head
            if(current == head) {

                head = head.next;

                if(head != null)
                    head.prev = null;
            }

            // delete tail
            else if(current == tail) {

                tail = tail.prev;

                if(tail != null)
                    tail.next = null;
            }

            // delete middle
            else {

                current.prev.next =
                    current.next;

                current.next.prev =
                    current.prev;
            }

            System.out.println("Deleted!");

            return deletedData;
        }

        current = current.next;
    }

    System.out.println("Transaction not found");

    return null;
}
