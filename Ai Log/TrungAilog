                    }

                    break;

                case 5:

                    if (undoStack.isEmpty()) {

                        System.out.println(
                                "Nothing to Undo.");

                        break;
                    }

                    Action action =
                            undoStack.pop();

                    if (action.actionType
                            .equals("ADD")) {

